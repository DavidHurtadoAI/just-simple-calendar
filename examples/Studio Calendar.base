filters:
  and:
    - file.inFolder("Simple Calendar Demo/Notes")
    - file.ext == "md"
views:
  - type: just-simple-calendar
    name: Studio calendar
    dateProperty: note.start_date
    endDateProperty: note.end_date
    weekStart: "1"
    order:
      - file.name
      - note.start_date
      - note.end_date
    sort:
      - property: note.start_date
        direction: ASC
  - type: table
    name: All events
    order:
      - file.name
      - note.start_date
      - note.end_date
      - note.focus
